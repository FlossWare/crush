# LiteLLM proxy URL (no trailing slash)
LITELLM_URL=http://localhost:4000

# LiteLLM master key (must match general_settings.master_key in litellm-config.yaml).
# Leave empty if the proxy does not require auth.
LITELLM_MASTER_KEY=

# Default arbiter model (must be available in LiteLLM)
DEFAULT_ARBITER=gemini-3.5-flash

# Explicit worker fleet (comma-separated). If unset, uses DEFAULT_WORKERS in models.py.
# WORKER_FLEET=gemini-3.5-flash,llama-3.3-70b,mistral-small

# Max parallel worker calls (1–50). Invalid values fail at startup with a clear error.
# MAX_CONCURRENT_WORKERS=10

# Retry count for transient worker failures (0–10).
# WORKER_RETRIES=2

# REST API bind address and port (API_PORT validated 1–65535 at startup).
# API_HOST=127.0.0.1
# API_PORT=8080

# Optional REST shared secret. When set, /v1/* requires X-API-Key or Authorization: Bearer.
# /health remains open for probes. Leave empty for localhost-only unauthenticated use.
# API_KEY=
